#!/bin/bash
# A-Check macOS 启动器
# 双击运行：在终端中启动交互式 IP 检测

APP_DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"
PY="$(command -v python3 || true)"

# 检查 python3
if [ -z "$PY" ]; then
    osascript -e 'display alert "需要 Python 3" message "请先安装 Python 3: https://www.python.org/downloads/"'
    exit 1
fi

# 校验 Python 版本 (>= 3.8, acheck.py 要求 3.8+)
if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then
    osascript -e 'display alert "需要 Python 3.8+" message "请先安装 Python 3.8 或更高版本: https://www.python.org/downloads/"'
    exit 1
fi

# 在终端中运行：路径经 osascript 参数传入（不在 AppleScript 源码中拼接），
# AppleScript 内用 quoted form of 转义后拼 shell 命令，目录名含 ' / " / 空格亦安全。
osascript - "$APP_DIR" "$PY" <<'APPLESCRIPT'
on run argv
    set appDir to item 1 of argv
    set pyBin to item 2 of argv
    tell application "Terminal"
        activate
        do script "cd " & quoted form of appDir & " && FORCE_COLOR=1 " & quoted form of pyBin & " acheck.py"
    end tell
end run
APPLESCRIPT
