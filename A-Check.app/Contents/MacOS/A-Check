#!/bin/bash
# A-Check macOS 启动器
# 双击运行：在终端中启动交互式 IP 检测

APP_DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"

# 候选解释器（按序）：Homebrew (Apple Silicon)、Homebrew (Intel)、
# python.org 框架版，最后取 PATH 中的 python3。只认 >= 3.8 的解释器。
# 注意：/usr/bin/python3 在未装 CLT 时是 xcrun 桩，调用会弹安装提示；
# 须先用 xcode-select -p 确认 CLT 已装，才可取用该路径。
_py_ok() {  # $1=解释器路径：存在、可执行且版本 >= 3.8 即真
    [ -x "$1" ] || return 1
    "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null
}

PY=""
_FOUND_ANY=""
for _cand in /opt/homebrew/bin/python3 /usr/local/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/Current/bin/python3; do
    if [ -x "$_cand" ]; then
        _FOUND_ANY=1
        if _py_ok "$_cand"; then
            PY="$_cand"
            break
        fi
    fi
done
if [ -z "$PY" ]; then
    _pv="$(command -v python3 || true)"
    if [ -n "$_pv" ]; then
        _FOUND_ANY=1
        if [ "$_pv" = "/usr/bin/python3" ]; then
            # xcrun 桩：先确认 CLT 已装，否则调用会弹安装提示
            if xcode-select -p >/dev/null 2>&1 && _py_ok "$_pv"; then
                PY="$_pv"
            fi
        elif _py_ok "$_pv"; then
            PY="$_pv"
        fi
    fi
fi

# 检查 python3
if [ -z "$PY" ]; then
    if [ -z "$_FOUND_ANY" ]; then
        osascript -e 'display alert "需要 Python 3" message "请先安装 Python 3: https://www.python.org/downloads/"'
    else
        osascript -e 'display alert "需要 Python 3.8+" message "请先安装 Python 3.8 或更高版本: https://www.python.org/downloads/"'
    fi
    exit 1
fi

# 在终端中运行：路径经 osascript 参数传入（不在 AppleScript 源码中拼接），
# AppleScript 内用 quoted form of 转义后拼 shell 命令，目录名含 ' / " / 空格亦安全。
# VAR=1 前缀在 tcsh 下是语法错误，改走 /usr/bin/env 设环境变量。
osascript - "$APP_DIR" "$PY" <<'APPLESCRIPT'
on run argv
    set appDir to item 1 of argv
    set pyBin to item 2 of argv
    tell application "Terminal"
        activate
        do script "cd " & quoted form of appDir & " && /usr/bin/env FORCE_COLOR=1 " & quoted form of pyBin & " acheck.py"
    end tell
end run
APPLESCRIPT
