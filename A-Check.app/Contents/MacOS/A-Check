#!/bin/bash
# A-Check macOS 启动器
# 双击运行：在终端中启动交互式 IP 检测

APP_DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"

# 检查 python3
if ! command -v python3 &> /dev/null; then
    osascript -e 'display alert "需要 Python 3" message "请先安装 Python 3: https://www.python.org/downloads/"'
    exit 1
fi

# 在终端中运行
osascript <<EOF
tell application "Terminal"
    activate
    do script "cd '$APP_DIR' && FORCE_COLOR=1 python3 acheck.py"
end tell
EOF
